      try_files $uri =404;
    }

    location / {
      try_files $uri $uri/ =404;
    }
  }

  ########################################################################
  # PROD APP
  ########################################################################
  server {
    listen 8080;
    server_name app.knowtowin.com;

    absolute_redirect off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-App-Version $APP_VERSION_PROD always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cross-Origin-Opener-Policy same-origin-allow-popups always;
    add_header Cross-Origin-Embedder-Policy credentialless always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    error_page 418 = @redir_prod;

    root  /usr/share/nginx/html;
    index index.html;

    location @redir_prod {
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "private, no-store" always;
      return 302 $redir_url_prod;
    }

    location = /main.dart.mjs {
      if ($need_vredir_prod) { return 418; }
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "no-store, must-revalidate" always;
      try_files $uri =404;
    }

    location = /index.html {
      if ($request_uri = /index.html) { return 301 /; }
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "no-store, must-revalidate" always;
      add_header Pragma "no-cache" always;
      add_header Expires "0" always;
      try_files $uri =404;
    }
    location = /flutter_bootstrap.js {
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "no-store, must-revalidate" always;
      try_files $uri =404;
    }
    location = /manifest.json {
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "no-store, must-revalidate" always;
      try_files $uri =404;
    }

    location = /robots.txt {
      default_type text/plain;
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "public, max-age=3600" always;
      return 200 "User-agent: *\nDisallow: /\n";
    }
    location = /sitemap.xml {
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "public, max-age=3600" always;
      return 404;
    }
    location = /sitemap-index.xml {
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "public, max-age=3600" always;
      return 404;
    }

    location = /flutter_service_worker.js {
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "no-store, must-revalidate" always;
      try_files $uri =404;
    }
    location = /sw-offline.js {
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "no-store, must-revalidate" always;
      try_files $uri =404;
    }
    location = /firebase-messaging-sw.js {
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Service-Worker-Allowed "/" always;
      add_header Cache-Control "no-store, must-revalidate" always;
      try_files $uri =404;
    }
    location = /sw-kill.js {
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "no-store, must-revalidate" always;
      try_files $uri =404;
    }

    location = /__app_version {
      default_type text/plain;
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "no-store, must-revalidate" always;
      return 200 "$APP_VERSION_PROD";
    }

    location ^~ /.well-known/ {
      default_type application/json;
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "public, max-age=3600" always;
      try_files $uri =404;
    }

    location ^~ /canvaskit/ {
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "public, max-age=604800" always;
      add_header Vary "Accept-Encoding" always;
      try_files $uri =404;
    }

    location ~* ^/assets/packages/font_awesome_flutter/lib/fonts/Font(?:%20|%2520)Awesome(?:%20|%2520)7(?:%20|%2520)(Brands-Regular-400|Free-Regular-400|Free-Solid-900)\.otf$ {
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "private, no-store" always;
      return 302 /Font%20Awesome%207%20$1.otf?$canon_qs_prod;
    }

    location ~* \.(?:mjs|js|css|png|jpg|jpeg|gif|ico|svg|webp|wasm|otf|woff2?|ttf|json)$ {
      if ($need_vredir_prod) { return 418; }
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "public, max-age=31536000, immutable" always;
      try_files $uri =404;
    }

    location = /__force_update__ {
      default_type text/plain;
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Clear-Site-Data "\"cache\", \"storage\"" always;
      return 200 "ok\n";
    }

    location / {
      try_files $uri $uri/ /index.html;
      include /etc/nginx/snippets/app_prod_headers.conf;
      add_header Cache-Control "no-store, must-revalidate" always;
    }
  }


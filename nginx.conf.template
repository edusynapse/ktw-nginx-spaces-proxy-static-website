  ########################################################################
  # SPONSOR LANDING — production CDN
  # Beacon img-src extra hosts: none at first ship.
  # Adding an approved collect host: edit this CSP, rebuild, redeploy. Not a runtime setting.
  ########################################################################
  server {
    listen 8080;
    server_name sponsorpages.knowtowin.com;

    absolute_redirect off;
    resolver 8.8.8.8 1.1.1.1 valid=30s;

    location / {
      # Official contexts: add_header = http/server/location/if-in-location
      # (https://nginx.org/en/docs/http/ngx_http_headers_module.html).
      # limit_except inner block is for access/auth only
      # (https://nginx.org/en/docs/http/ngx_http_core_module.html#limit_except);
      # deny is valid there (https://nginx.org/en/docs/http/ngx_http_access_module.html).
      # GET implies HEAD. deny all → 403, not 405.
      limit_except GET {
        deny all;
      }
      add_header Allow "GET, HEAD" always;
      add_header Content-Security-Policy "default-src 'none'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' https://cdn.knowtowin.com; connect-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors https://app.knowtowin.com https://devapp.knowtowin.com;" always;
      add_header X-Content-Type-Options "nosniff" always;
      add_header Referrer-Policy "no-referrer" always;
      add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
      add_header Strict-Transport-Security "max-age=31536000" always;
      add_header X-Robots-Tag "noindex, nofollow" always;

      set $landing_cdn "https://cdn.knowtowin.com";
      proxy_pass $landing_cdn/sponsor_landing$uri;
      proxy_ssl_server_name on;
      proxy_ssl_name cdn.knowtowin.com;
      proxy_ssl_verify on;
      proxy_ssl_verify_depth 3;
      proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
      proxy_set_header Host cdn.knowtowin.com;
      proxy_set_header Cookie "";
      proxy_set_header Authorization "";
      proxy_pass_request_body off;
      proxy_hide_header Content-Security-Policy;
      proxy_hide_header Content-Security-Policy-Report-Only;
      proxy_hide_header X-Frame-Options;
      proxy_hide_header Set-Cookie;
      proxy_hide_header Strict-Transport-Security;
    }
  }


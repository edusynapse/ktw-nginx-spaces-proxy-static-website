    location = /downloads.html {
      include /etc/nginx/snippets/apex_headers.conf;
      add_header Cache-Control "public, max-age=600, must-revalidate" always;
      try_files $uri =404;
    }

    location ~ ^/(index|support|jobs|app|services|partners|downloads)_[A-Z][A-Z]\.html$ {
      include /etc/nginx/snippets/apex_headers.conf;
      add_header Cache-Control "public, max-age=600, must-revalidate" always;
      try_files $uri =404;
    }

    location = /robots.txt {
      include /etc/nginx/snippets/apex_headers.conf;
      add_header Cache-Control "public, max-age=3600" always;
      try_files $uri =404;
    }

